<%- include('../partials/head', {
  subtitle: 'Templates, validation and bulk loading',
  headerActions: can('import.history') ? '<a class="btn" href="/import/history">Import history</a>' : ''
}) %>

<div class="card">
  <div class="card-head"><h2>Modules</h2></div>
  <div class="card-body tight">
    <div class="table-wrap">
      <table class="table">
        <thead><tr><th>Module</th><th>Template</th><th></th></tr></thead>
        <tbody>
          <% modules.forEach(function (m) { %>
            <tr>
              <td class="strong"><%= m.plural || m.label %></td>
              <td class="nowrap">
                <a class="btn btn-sm" href="/import/<%= m.slug %>/template.csv?variant=blank">Blank</a>
                <a class="btn btn-sm" href="/import/<%= m.slug %>/template.csv?variant=sample">With sample</a>
                <% if (can('data.export')) { %>
                  <a class="btn btn-sm" href="/import/<%= m.slug %>/template.csv?variant=data">Existing data</a>
                <% } %>
              </td>
              <td class="nowrap">
                <% if (can('import.run')) { %>
                  <a class="btn btn-sm btn-primary" href="/import/<%= m.slug %>">Import CSV</a>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<% if (jobs.length > 0) { %>
  <div class="card">
    <div class="card-head">
      <h2>Recent runs</h2>
      <a class="btn btn-sm" href="/import/history">All runs</a>
    </div>
    <div class="card-body tight">
      <table class="table">
        <thead><tr><th>Started</th><th>Module</th><th>File</th><th>Mode</th><th>Result</th><th>Status</th></tr></thead>
        <tbody>
          <% jobs.forEach(function (job) { %>
            <tr>
              <td class="nowrap small"><a href="/import/jobs/<%= job.id %>"><%= dt(job.started_at) %></a></td>
              <td><%= job.module %></td>
              <td class="small"><%= job.file_name %></td>
              <td><span class="pill <%= job.mode === 'COMMIT' ? 'info' : '' %>"><%= job.mode %></span></td>
              <td class="small"><%= job.rows_inserted %> created, <%= job.rows_updated %> updated, <%= job.rows_failed %> failed</td>
              <td><span class="pill <%= statusClass(job.status) %>"><%= job.status %></span></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
<% } %>

<div class="card">
  <div class="card-head"><h2>How a CSV must look</h2></div>
  <div class="card-body">
    <ul class="small muted" style="margin:0; padding-left:18px">
      <li>UTF-8 without a byte order mark, comma separated, quotes around any value containing a comma.</li>
      <li>Row 1 holds the column headers from the template. Row 2 may hold the description line and is skipped.</li>
      <li>Dates use yyyy-MM-dd. Multiple values in one cell are separated with a semicolon.</li>
      <li>Set action to CREATE for new records, or UPDATE with the existing reference in existing_reference.</li>
      <li>References are generated by the system. Never type one into a CREATE row.</li>
    </ul>
  </div>
</div>

<%- include('../partials/foot') %>
