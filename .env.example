# Connection string for the PostgreSQL database.
DATABASE_URL=postgres://user:password@host:5432/ippms?sslmode=require

# 32 byte key, hex or base64, that encrypts tenant SMTP passwords at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=

# Signing key for session cookies.
SESSION_SECRET=

# Years of audit history kept in audit_logs before the monthly job moves it
# to audit_logs_archive.
AUDIT_RETENTION_YEARS=5

# Set to true when the app is served over HTTPS so session cookies are secure only.
COOKIE_SECURE=false
